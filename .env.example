# Telegram
TELEGRAM_BOT_TOKEN=

# Encryption key for users' Gemini API keys (generate once: Fernet.generate_key())
ENCRYPTION_KEY=

# Gemini model used for parsing food (text and photos — Gemini models are natively multimodal)
# and computing targets.
GEMINI_MODEL=gemini-flash-latest

# Database
DATABASE_PATH=./data/bot.db

# Weekly weight check-in schedule
WEEKLY_WEIGHT_CHECK_DAY=sunday
WEEKLY_WEIGHT_CHECK_TIME=10:00

# Timezone
TIMEZONE=UTC

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# Comma-separated Telegram user IDs allowed to run /stats (leave empty to disable)
ADMIN_TELEGRAM_IDS=
