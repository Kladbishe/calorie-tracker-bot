# Telegram
TELEGRAM_BOT_TOKEN=

# Encryption key for users' OpenAI API keys (generate once: Fernet.generate_key())
ENCRYPTION_KEY=

# OpenAI model for parsing free-text food logs
OPENAI_TEXT_MODEL=gpt-4o-mini

# OpenAI model for parsing food photos (vision)
OPENAI_VISION_MODEL=gpt-4o

# Database
DATABASE_PATH=./data/bot.db

# Weekly weight check-in schedule
WEEKLY_WEIGHT_CHECK_DAY=sunday
WEEKLY_WEIGHT_CHECK_TIME=10:00

# Timezone
TIMEZONE=UTC

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# Comma-separated Telegram user IDs allowed to run /stats (leave empty to disable)
ADMIN_TELEGRAM_IDS=
